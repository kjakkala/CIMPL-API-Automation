# Copy this file to .env and fill in real values. Never commit .env to source control.

# --- OAuth2 Token Endpoint ---
TOKEN_URL=https://your-qa-host.example.com/auth/oauth/token
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret
# If using Resource Owner Password grant, also set:
API_USERNAME=your_username
API_PASSWORD=your_password
# Grant type: "client_credentials" or "password"
GRANT_TYPE=password

# --- API Base URL ---
BASE_URL=https://your-qa-host.example.com/api/v1

# --- TestRail Dashboard Mapping ---
# Example: https://testrail.example.com/index.php?/cases/view/{case_id}
TESTRAIL_CASE_URL_TEMPLATE=

# --- TestRail Run Integration ---
TESTRAIL_ENABLE_ON_RUN=1
TESTRAIL_URL=https://upland.testrail.com
TESTRAIL_EMAIL=your_email@example.com
TESTRAIL_API_KEY=your_api_key
TESTRAIL_PROJECT_ID=30
TESTRAIL_MILESTONE_ID=2676
TESTRAIL_SUITE_ID=63080

# --- SQL Server Connection (Windows Authentication - no password required) ---
DB_SERVER=your_sql_server\your_instance
DB_NAME=<default>
# Windows Auth is used - leave DB_USER and DB_PASSWORD blank
DB_USER=
DB_PASSWORD=
DB_TRUSTED_CONNECTION=1

# --- Reverse proxy base path (set only when hosted behind IIS under a sub-path) ---
# Example: APP_BASE_PATH=/ApiAutomation
APP_BASE_PATH=
